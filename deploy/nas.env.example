# new-api · NAS 部署配置（模板）
#
# 用法：
#   cp deploy/nas.env.example deploy/nas.env
#   然后按实际情况修改 deploy/nas.env
#
# deploy/nas.env 已被 .gitignore 忽略，不会提交到仓库。
#
# ── 权限模型 ──────────────────────────────────────────────────────────
# 本地只做「构建 + 传输」；所有 docker 操作都由 NAS 上的
# deploy/remote-deploy.sh 以 root 执行。
# ★ 需要为 NAS 部署账号配置**免密 sudo**（NOPASSWD），否则脚本在无终端
#   环境下无法提权。DSM 上执行 `sudo visudo` 加入：
#     <DSM 账号> ALL=(ALL) NOPASSWD: ALL
#   验证：ssh <账号>@<NAS> -p <端口> 'sudo -n true'

# ---------------------------------------------------------------- NAS 连接
# 群晖 NAS 地址
NAS_HOST=192.168.1.x
# SSH 端口（群晖默认 22；需在 DSM 中先启用 SSH 服务）
NAS_SSH_PORT=22
# DSM 登录账号（不是 new-api 的账号）
NAS_SSH_USER=
# SSH 私钥路径；留空则使用 ssh 默认密钥或交互式密码
NAS_SSH_KEY=~/.ssh/id_ed25519_newapi_nas

# ------------------------------------------------------ new-api 部署位置
# compose.yaml 所在目录（NAS 上的绝对路径）
NAS_DEPLOY_DIR=/volume1/docker/new-api
# compose 文件名
NAS_COMPOSE_FILE=compose.yaml
# 部署后用于本地复核的访问地址（留空则跳过）
NAS_API_URL=http://192.168.1.x:3000

# ------------------------------------------------------------------- 镜像
IMAGE_NAME=new-api
# 三种写法：
#   1) 带时间戳的版本名（推荐，便于在 NAS 上分辨版本）：
#        IMAGE_TAG="v1.0.0-rc.36-custom.$(date +%Y%m%d%H%M)"
#      每次 deploy 展开成唯一标签，如 v1.0.0-rc.36-custom.202610161006
#   2) 固定版本名：IMAGE_TAG=v1.0.0-rc.36-custom.2
#   3) 留空：自动生成 local-YYYYMMDD-HHMMSS
IMAGE_TAG="v1.0.0-rc.36-custom.$(date +%Y%m%d%H%M)"
