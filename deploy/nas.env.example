# new-api · NAS 部署配置（模板）
#
# 用法：
#   cp deploy/nas.env.example deploy/nas.env
#   然后按实际情况修改 deploy/nas.env
#
# deploy/nas.env 已被 .gitignore 忽略，不会提交到仓库。

# ---------------------------------------------------------------- NAS 连接
# 群晖 NAS 地址
NAS_HOST=192.168.1.10
# SSH 端口（群晖默认 22；需在 DSM 中先启用 SSH 服务）
NAS_SSH_PORT=22
# DSM 登录账号（不是 new-api 的账号）
NAS_SSH_USER=
# SSH 私钥路径；留空则使用 ssh 默认密钥或交互式密码
NAS_SSH_KEY=~/.ssh/id_ed25519_newapi_nas

# ------------------------------------------------------ new-api 部署位置
# docker-compose.yml 所在目录（在 NAS 上的绝对路径）
NAS_DEPLOY_DIR=/volume1/docker/new-api
# 容器名 / compose 服务名
NAS_CONTAINER=new-api
NAS_SERVICE=new-api
# 用于部署后自检的访问地址
NAS_API_URL=http://192.168.1.10:53130

# ------------------------------------------------------------------- 镜像
IMAGE_NAME=new-api
IMAGE_TAG=v1.0.0-rc.36-custom.1
# 回滚时使用的 tag（首次部署前先给旧镜像打上这个 tag）
ROLLBACK_TAG=new-api:rollback-rc36

# ------------------------------------------------------------------- 备份
# 备份文件在 NAS 上的落地目录
NAS_BACKUP_DIR=/volume1/docker/new-api/backups

# --------------------------------------------------- docker 提权与 compose
# docker.sock 是 root:root 且系统无 docker 组，所以需要 sudo。
# 在 NAS 上配置好 NOPASSWD 后，把下面改成 NAS_SUDO='sudo -n'
# （配置方法见 CUSTOMIZATION-DEPLOY-PLAN.md 第 3.3.2 节）
NAS_SUDO=
# compose 文件名（本机实际是 compose.yaml）
NAS_COMPOSE_FILE=compose.yaml
# compose 项目名；留空则由 docker 按目录名推断
NAS_COMPOSE_PROJECT=
# compose 使用的 env 文件
NAS_ENV_FILE=.env
# 群晖 SSH 的 PATH 缺少 /usr/local/bin，脚本会远端注入
REMOTE_PATH=/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin
# 若 compose 固定了 container_name，可在此指定；留空则自动解析
NAS_CONTAINER=
