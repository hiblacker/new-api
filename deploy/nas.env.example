# new-api · NAS 部署配置（模板）
#
# 用法：
#   cp deploy/nas.env.example deploy/nas.env
#   然后按实际情况修改 deploy/nas.env
#
# deploy/nas.env 已被 .gitignore 忽略，不会提交到仓库。
#
# ── 权限模型 ──────────────────────────────────────────────────────────
# 本地只做「构建 + 传输」；所有 docker 操作都由 NAS 上的
# deploy/remote-deploy.sh 以 root 执行。你只需要在提示时输一次 sudo 密码。
# 因此本文件**不需要**任何 sudo / NOPASSWD 配置。

# ---------------------------------------------------------------- NAS 连接
# 群晖 NAS 地址
NAS_HOST=192.168.1.10
# SSH 端口（群晖默认 22；需在 DSM 中先启用 SSH 服务）
NAS_SSH_PORT=22
# DSM 登录账号（不是 new-api 的账号）
NAS_SSH_USER=
# SSH 私钥路径；留空则使用 ssh 默认密钥或交互式密码
NAS_SSH_KEY=~/.ssh/id_ed25519_newapi_nas

# ------------------------------------------------------ new-api 部署位置
# compose.yaml 所在目录（NAS 上的绝对路径）
NAS_DEPLOY_DIR=/volume1/docker/new-apiv1
# compose 文件名
NAS_COMPOSE_FILE=compose.yaml
# 部署后用于本地复核的访问地址（留空则跳过）
NAS_API_URL=http://192.168.1.10:53130

# ------------------------------------------------------------------- 镜像
IMAGE_NAME=new-api
# 留空时每次部署自动生成 local-YYYYMMDD-HHMMSS，无需手工更新。
# 只有需要固定版本名时才填写，例如：IMAGE_TAG=v1.0.0-rc.36-custom.1
IMAGE_TAG=
